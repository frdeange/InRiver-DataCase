# Azure AI Foundry
AZURE_AI_PROJECT_ENDPOINT=https://your-foundry.services.ai.azure.com/api/projects/your-project
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-5.2

# Azure SQL — one per tenant
SQL_CONN_ACME=Driver={ODBC Driver 18 for SQL Server};Server=sql-inriver-poc.database.windows.net;Database=db-acme;Authentication=ActiveDirectoryManagedIdentity;
SQL_CONN_NOVA=Driver={ODBC Driver 18 for SQL Server};Server=sql-inriver-poc.database.windows.net;Database=db-nova;Authentication=ActiveDirectoryManagedIdentity;
SQL_CONN_APEX=Driver={ODBC Driver 18 for SQL Server};Server=sql-inriver-poc.database.windows.net;Database=db-apex;Authentication=ActiveDirectoryManagedIdentity;

# Entra ID
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-api-client-id

# Observability
LOG_LEVEL=INFO
AUDIT_LOG_PATH=./audit_logs
APPLICATIONINSIGHTS_CONNECTION_STRING=
