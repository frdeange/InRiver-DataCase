{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "value": "westeurope"
    },
    "environment": {
      "value": "demo"
    },
    "sqlAdminLogin": {
      "value": "sqladmin"
    },
    "sqlAdminPassword": {
      "value": "<REPLACE_ME>"
    },
    "appInsightsConnectionString": {
      "value": "<REPLACE_ME>"
    },
    "openAiEndpoint": {
      "value": "https://<your-foundry-name>.openai.azure.com/"
    },
    "openAiKey": {
      "value": "<REPLACE_ME>"
    }
  }
}
