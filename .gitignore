# Squad: ignore runtime state (logs, inbox, sessions)
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream

# Infra secrets — never commit real parameter files
infra/parameters.*.json
!infra/parameters.*.json.example

# Bicep compiled ARM JSON output (generated by az bicep build)
infra/*.json
!infra/parameters.*.json.example
