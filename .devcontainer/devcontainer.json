// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/python
{
	"name": "Python 3",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/python:3-3.13-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/azure-cli:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [3000, 8000],
	"portsAttributes": {
		"3000": { "label": "Frontend (React)" },
		"8000": { "label": "Backend (FastAPI)" }
	},

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.black-formatter",
				"ms-azuretools.vscode-bicep",
				"ms-mssql.mssql",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			]
		}
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	// Commands run in parallel (object form). ODBC install requires sudo for apt operations.
	"postCreateCommand": {
		"pip-setup": "pip install --upgrade pip && pip install -r requirements.txt && ([ -f backend/requirements.txt ] && pip install -r backend/requirements.txt || true)",
		"gh-copilot": "gh extension install github/gh-copilot",
		"odbc-driver": "curl https://packages.microsoft.com/keys/microsoft.asc | sudo apt-key add - && curl https://packages.microsoft.com/config/debian/12/prod.list | sudo tee /etc/apt/sources.list.d/mssql-release.list && sudo apt-get update -q && ACCEPT_EULA=Y sudo apt-get install -y msodbcsql18 mssql-tools18 unixodbc-dev",
		"frontend-deps": "cd frontend && npm install || true"
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
