// For format details, see https://aka.ms/devcontainer.json
{
	"name": "InRiver DataCase",
	"image": "mcr.microsoft.com/devcontainers/python:3-3.13-bookworm",

	"features": {
		"ghcr.io/devcontainers/features/azure-cli:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {},
		"ghcr.io/devcontainers/features/node:1":{},
		"ghcr.io/devcontainers/features/github-cli:1": {}
	},

	"forwardPorts": [3000, 5173, 8000],
	"portsAttributes": {
		"3000": { "label": "Frontend (Docker/Nginx)", "onAutoForward": "notify" },
		"5173": { "label": "Frontend (Vite Dev)", "onAutoForward": "openBrowser" },
		"8000": { "label": "Backend (FastAPI)", "onAutoForward": "notify" }
	},

	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"ms-python.vscode-pylance",
				"ms-python.black-formatter",
				"ms-azuretools.vscode-bicep",
				"ms-azuretools.vscode-docker",
				"ms-mssql.mssql",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"bradlc.vscode-tailwindcss",
				"GitHub.copilot",
				"GitHub.copilot-chat"
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/local/bin/python",
				"[python]": {
					"editor.defaultFormatter": "ms-python.black-formatter",
					"editor.formatOnSave": true
				},
				"[typescript][typescriptreact][javascript][json]": {
					"editor.defaultFormatter": "esbenp.prettier-vscode",
					"editor.formatOnSave": true
				}
			}
		}
	},

	// postCreateCommand: each key runs in parallel.
	// odbc-and-sqlcmd: installs ODBC driver 18 + sqlcmd (mssql-tools18).
	// Uses --yes for gpg to overwrite without prompt, and --batch for non-interactive.
	"postCreateCommand": {
		"pip-setup": "pip install --upgrade pip && pip install -r requirements.txt && ([ -f backend/requirements.txt ] && pip install -r backend/requirements.txt || true)",
		"gh-copilot": "gh extension install github/gh-copilot 2>/dev/null || true",
		"az-bicep": "az bicep install 2>/dev/null && echo 'bicep installed OK' || true",
		"odbc-and-sqlcmd": "sudo rm -f /usr/share/keyrings/microsoft-prod.gpg && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | sudo gpg --batch --yes --dearmor -o /usr/share/keyrings/microsoft-prod.gpg && echo 'deb [signed-by=/usr/share/keyrings/microsoft-prod.gpg] https://packages.microsoft.com/debian/12/prod bookworm main' | sudo tee /etc/apt/sources.list.d/mssql-release.list > /dev/null && sudo apt-get update -qq 2>/dev/null && sudo ACCEPT_EULA=Y DEBIAN_FRONTEND=noninteractive apt-get install -y -qq msodbcsql18 unixodbc-dev 2>/dev/null && echo 'ODBC driver installed OK' || echo 'WARN: ODBC install failed'",
		"go-sqlcmd": "curl -fsSL https://github.com/microsoft/go-sqlcmd/releases/latest/download/sqlcmd-linux-amd64.tar.bz2 -o /tmp/sqlcmd.tar.bz2 && sudo tar xjf /tmp/sqlcmd.tar.bz2 -C /usr/local/bin sqlcmd && rm /tmp/sqlcmd.tar.bz2 && echo 'go-sqlcmd installed OK' || echo 'WARN: go-sqlcmd install failed'",
		"frontend-deps": "cd frontend && npm install || true",
		"env-templates": "[ ! -f backend/.env ] && [ -f backend/.env.example ] && cp backend/.env.example backend/.env || true; [ ! -f frontend/.env ] && [ -f frontend/.env.example ] && cp frontend/.env.example frontend/.env || true"
	},

	// Ensure sqlcmd (/opt/mssql-tools18/bin) is always in PATH
	"remoteEnv": {
		"PATH": "${containerEnv:PATH}:/opt/mssql-tools18/bin:/home/vscode/.local/bin"
	}
}
